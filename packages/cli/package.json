{
  "name": "@avi2dg/orc-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The tui-dash command, composing the panel modules into the dashboard, opening one panel alone, printing reports and snapshots, or streaming alert events",
  "repository": "https://github.com/avi2d/orc.git",
  "author": "avi2d <avi2dg@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "tui-dash": "src/bin.ts"
  },
  "scripts": {
    "build": "bun build src/bin.ts --outdir dist --target bun --external @opentui/core --external effect --external @effect/platform-bun",
    "start": "bun src/bin.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@opentui/core": "0.6.5",
    "@avi2dg/orc-alerts": "workspace:*",
    "@avi2dg/orc-dashboard": "workspace:*",
    "@avi2dg/orc-dispatch": "workspace:*",
    "@avi2dg/orc-ledger": "workspace:*",
    "@avi2dg/orc-queues": "workspace:*",
    "@avi2dg/orc-quota": "workspace:*",
    "@avi2dg/orc-resources": "workspace:*",
    "@avi2dg/orc-schedules": "workspace:*",
    "@avi2dg/orc-schema": "workspace:*",
    "@avi2dg/orc-session-quota": "workspace:*",
    "@avi2dg/orc-tasks": "workspace:*",
    "@avi2dg/orc-ui": "workspace:*",
    "effect": "4.0.0"
  }
}
