{
  "name": "orc",
  "version": "0.3.0",
  "private": true,
  "description": "One task to one pull request: Pi in a nono sandbox, the project's checks, then no-mistakes",
  "repository": "https://github.com/avi2d/orc.git",
  "author": "avi2d <avi2dg@gmail.com>",
  "type": "module",
  "bin": {
    "orc": "src/bin.ts"
  },
  "scripts": {
    "build": "bun build src/bin.ts --outdir dist --target bun && checks-effect-scope && checks-changelog",
    "lint": "mkdir -p .orc-home && HOME=$PWD/.orc-home PATH=$PWD/scripts:$PATH oxlint && HOME=$PWD/.orc-home PATH=$PWD/scripts:$PATH checks-lint",
    "postinstall": "bun scripts/patch-knip-jiti.ts",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "checks-test",
    "test:live": "checks-test --tier=live"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@effect/platform-bun": "4.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@avi2dg/checks": "^0.44.0",
    "@effect/tsgo": "0.45.0",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@stryker-mutator/core": "10.0.0",
    "@swc/core": "1.16.2",
    "@types/bun": "^1.3.0",
    "dependency-cruiser": "18.4.0",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
