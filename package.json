{
  "name": "orc",
  "version": "0.25.0",
  "private": true,
  "description": "One chat to run your AI agent work on all your machines and models, with a backlog, live monitoring and Herdr App dashboards.",
  "license": "MIT",
  "repository": "https://github.com/avi2d/orc.git",
  "author": "avi2d <avi2dg@gmail.com>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "bundle": "bun scripts/bundle.ts",
    "build:pack": "bun scripts/build-pack.ts",
    "build:launcher": "bun scripts/build-launcher.ts",
    "compile": "bun packages/run/scripts/compile.ts",
    "release:assets": "bun scripts/release-assets.ts",
    "lint": "bun scripts/lint-repo.ts && bun scripts/lint-env.ts oxlint && bun scripts/lint-env.ts checks-lint",
    "postinstall": "bun scripts/postinstall.ts",
    "prepare": "checks-vendor --library effect --package effect --repository https://github.com/Effect-TS/effect.git --tag 'effect@{version}' --path packages/effect/package.json",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict && bun scripts/vue-typecheck.ts --noEmit -p tsconfig.vue.json",
    "pretest": "bun run bundle",
    "pretest:fast": "bun run bundle",
    "pretest:e2e": "bun run bundle",
    "test": "checks-test",
    "test:fast": "checks-test --changed",
    "test:unit": "checks-test --tier=unit",
    "test:e2e": "checks-test --tier=e2e",
    "test:live": "checks-test --tier=live",
    "bench:start": "bun scripts/bench-start.ts",
    "docs:diagrams": "bun scripts/docs-diagrams.ts",
    "docs:dev": "vitepress dev docs",
    "docs:check": "bun scripts/check-doc-sections.ts",
    "docs:build": "bun run docs:check && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dashboard": "bun packages/cli/src/bin.ts",
    "dashboard-print": "bun packages/cli/src/bin.ts --print",
    "session-quota-json": "bun packages/cli/src/bin.ts report session-quota",
    "session-quota-composed-json": "bun packages/cli/src/bin.ts report session-quota-composed",
    "session-quota-alerts": "bun packages/cli/src/bin.ts report session-quota-alerts",
    "resources-json": "bun packages/cli/src/bin.ts report resources",
    "tasks-live-json": "bun packages/cli/src/bin.ts report tasks-live",
    "tasks-sample": "bun packages/cli/src/bin.ts sample tasks"
  },
  "devDependencies": {
    "@avi2dg/checks": "0.120.0",
    "@avi2dg/orc-alerts": "workspace:*",
    "@avi2dg/orc-attention": "workspace:*",
    "@avi2dg/orc-cli": "workspace:*",
    "@avi2dg/orc-dashboard": "workspace:*",
    "@avi2dg/orc-dispatch": "workspace:*",
    "@avi2dg/orc-ledger": "workspace:*",
    "@avi2dg/orc-queues": "workspace:*",
    "@avi2dg/orc-quota": "workspace:*",
    "@avi2dg/orc-resources": "workspace:*",
    "@avi2dg/orc-schedules": "workspace:*",
    "@avi2dg/orc-schema": "workspace:*",
    "@avi2dg/orc-session-quota": "workspace:*",
    "@avi2dg/orc-tasks": "workspace:*",
    "@avi2dg/orc-ui": "workspace:*",
    "@dagrejs/dagre": "3.1.3",
    "@effect/platform-bun": "4.1.4",
    "@effect/tsgo": "0.45.0",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@opentui/core": "0.6.5",
    "@stryker-mutator/core": "10.0.0",
    "@swc/core": "1.16.2",
    "@types/bun": "^1.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vue-flow/core": "1.48.2",
    "dependency-cruiser": "18.4.0",
    "effect": "4.1.4",
    "fast-check": "4.11.0",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.4",
    "minimatch": "11.0.3",
    "qs": "6.16.1",
    "vite": "6.4.6"
  },
  "trustedDependencies": [
    "@swc/core"
  ],
  "patchedDependencies": {
    "@hughescr/stryker-bun-runner@1.6.0": "patches/@hughescr%2Fstryker-bun-runner@1.6.0.patch"
  }
}
