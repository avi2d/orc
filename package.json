{
  "name": "orc",
  "version": "0.4.0",
  "private": true,
  "description": "One task to one pull request: Pi in a nono sandbox, the project's checks, then no-mistakes, and the terminal dashboard of panels beside it",
  "license": "MIT",
  "repository": "https://github.com/avi2d/orc.git",
  "author": "avi2d <avi2dg@gmail.com>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun packages/run/scripts/sync-run-version.ts && bun build packages/run/src/bin.ts --outdir packages/run/dist --target bun && (cd packages/session-quota && bun run build) && (cd packages/cli && bun run build) && checks-effect-scope && checks-changelog && cp CHANGELOG.md packages/run/CHANGELOG.md",
    "lint": "mkdir -p .orc-home && HOME=$PWD/.orc-home PATH=$PWD/packages/run/scripts:$PATH oxlint && CHECKS_SECRETS_PACK=\"${CHECKS_SECRETS_PACK-$HOME/.config/checks/secrets-pack.json}\" HOME=$PWD/.orc-home PATH=$PWD/packages/run/scripts:$PATH checks-lint",
    "postinstall": "bun packages/run/scripts/patch-knip-jiti.ts && cp CHANGELOG.md packages/run/CHANGELOG.md",
    "prepare": "checks-vendor --library effect --package effect --repository https://github.com/Effect-TS/effect.git --tag 'effect@{version}' --path packages/effect/package.json",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "checks-test",
    "test:fast": "bun scripts/test-fast.ts",
    "test:live": "checks-test --tier=live",
    "dashboard": "bun packages/cli/src/bin.ts",
    "dashboard-print": "bun packages/cli/src/bin.ts --print",
    "session-quota-json": "bun packages/cli/src/bin.ts report session-quota",
    "session-quota-composed-json": "bun packages/cli/src/bin.ts report session-quota-composed",
    "session-quota-alerts": "bun packages/cli/src/bin.ts report session-quota-alerts",
    "resources-json": "bun packages/cli/src/bin.ts report resources",
    "tasks-live-json": "bun packages/cli/src/bin.ts report tasks-live",
    "tasks-sample": "bun packages/cli/src/bin.ts sample tasks"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@avi2dg/checks": "^0.57.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/tsgo": "0.45.0",
    "effect": "4.0.0",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@opentui/core": "0.6.5",
    "@stryker-mutator/core": "10.0.0",
    "@swc/core": "1.16.2",
    "@tui-dash/alerts": "workspace:*",
    "@tui-dash/cli": "workspace:*",
    "@tui-dash/dashboard": "workspace:*",
    "@tui-dash/dispatch": "workspace:*",
    "@tui-dash/ledger": "workspace:*",
    "@tui-dash/queues": "workspace:*",
    "@tui-dash/quota": "workspace:*",
    "@tui-dash/resources": "workspace:*",
    "@tui-dash/schedules": "workspace:*",
    "@tui-dash/schema": "workspace:*",
    "@tui-dash/session-quota": "workspace:*",
    "@tui-dash/tasks": "workspace:*",
    "@tui-dash/ui": "workspace:*",
    "@types/bun": "^1.3.0",
    "dependency-cruiser": "18.4.0",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
